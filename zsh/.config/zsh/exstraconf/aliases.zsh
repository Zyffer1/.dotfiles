# shortening
alias c='clear'
alias e='exit'
alias hello='yes hello'
alias sozsh='source ~/.zshrc'

# better shell utile
alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias fzf='fzf -m --preview="bat --color=always {}"'
alias cd='z'

#nvim
alias sunv='sudo nvim'
alias nano='nvim'

alias nfzf='nvim $(fzf -m --preview="bat --color=always {}")'
