{
  "$schema": "https://opencode.ai/config.json",

  "plugin": [
    "opencode-autodiscover",
    "@mohak34/opencode-notifier@latest"
  ],

  "default_agent": "setup",
  "lsp": true,

  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Laptop",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "exclude": ["*embed*", "*embedding*"]
      }
    }
  },

  "agent": {
    "setup": {
      "description": "Primary coordinator. Automatically uses all subagents to research, plan, test, execute, and verify.",
      "mode": "primary"
    },
    "plan": {
      "description": "Planning and discussion. Automatically uses researcher, paranoid, and driver to research and design.",
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    },
    "build": {
      "description": "Efficient implementation - takes an approved plan and executes it.",
      "mode": "subagent",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "allow",
        "glob": "allow",
        "grep": "allow",
        "task": "allow"
      }
    },
    "researcher": {
      "description": "Researches the setup - reads files, searches web, documents findings in ~/me/ai/aiinfo.md and ~/me/ai/plan.md.",
      "mode": "subagent"
    },
    "driver": {
      "description": "Proposes efficient, concrete solutions. Cuts through analysis paralysis.",
      "mode": "subagent"
    },
    "paranoid": {
      "description": "Security reviewer. Scrutinizes changes for risks, unsafe patterns, secret leakage.",
      "mode": "subagent"
    },
    "tester": {
      "description": "Project reviewer. Gives feedback about the current project - does NOT code.",
      "mode": "subagent"
    },
    "verifier": {
      "description": "Plan review pre and verification checklist post. Confirms everything works.",
      "mode": "subagent"
    },
    "idea-maker": {
      "description": "Creative idea generator. Brainstorms novel improvements and approaches.",
      "mode": "subagent"
    },
    "cleanup": {
      "description": "Housekeeping. Finds and removes dead configs, orphaned symlinks, empty dirs.",
      "mode": "subagent"
    }
  },

  "mcp": {
    "browser": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true
    },
    "searxng": {
      "type": "local",
      "command": ["npx", "-y", "mcp-searxng"],
      "enabled": true,
      "env": {
        "SEARXNG_URL": "http://localhost:8080"
      }
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true
    }
  }
}
